# GPU-oriented RAG capacity preset.
# This preset adjusts RAG worker/retrieval capacity only.
# It does NOT enable NVIDIA Docker runtime by itself.
# Use infrastructure/docker-compose.gpu.yml for GPU device access.
# NOTE: Docker Compose does NOT auto-load this file.
# To use this preset, set `RAG_HARDWARE_PROFILE=gpu` in `.env.self-host`.
# Only specify individual variables below if you wish to override the preset defaults.
RAG_HARDWARE_PROFILE=gpu
RAG_WORKER_CONCURRENCY=2
RAG_RETRIEVAL_CANDIDATES=40
RAG_RERANK_SOURCE_COUNT=40
RAG_RERANK_TOP_N=8
RAG_ADAPTIVE_RERANK_ENABLED=true
PROVIDER_POOL_MAX_ACTIVE_JOBS_PER_WORKSPACE=2
