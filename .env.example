# Application
APP_ENV=development
APP_NAME=RagHub API
APP_SECRET_KEY=change-me-in-local-env
PROVIDER_MASTER_KEY=replace-with-a-dedicated-provider-encryption-key
# Use local-ai to install sentence-transformers/PyTorch in API and worker images.
BACKEND_IMAGE_TARGET=runtime
# Local images; registry deployment uses .env.ghcr.example instead.
LOCAL_IMAGE_PREFIX=raghub
LOCAL_IMAGE_TAG=local
LOCAL_BIND_ADDRESS=127.0.0.1
API_V1_PREFIX=/api/v1
MAX_UPLOAD_SIZE_MB=25

# PostgreSQL
POSTGRES_DB=raghub
POSTGRES_USER=raghub
POSTGRES_PASSWORD=raghub-local-only
DATABASE_URL=postgresql+asyncpg://raghub:raghub-local-only@postgres:5432/raghub

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Elasticsearch
ELASTICSEARCH_URL=http://elasticsearch:9200

# MinIO / S3-compatible storage
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=raghub
S3_SECRET_KEY=raghub-local-only
S3_BUCKET=raghub-documents
S3_SECURE=false

# Legacy Gemini bootstrap settings (new credentials are stored through the provider API)
GEMINI_API_KEY=
# Optional bootstrap credentials; import once with app.cli.providers import-env.
GROQ_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
VOYAGE_API_KEY=
SILICONFLOW_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
HUGGINGFACE_TOKEN=
NVIDIA_NIM_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL=gemini-3.5-flash-lite
CHAT_PROVIDER_TIMEOUT_SECONDS=45

# Reserved for later phases
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
REFRESH_REUSE_GRACE_SECONDS=10
AUTH_LOGIN_REQUESTS_PER_IP=10
AUTH_LOGIN_REQUESTS_PER_ACCOUNT=5
AUTH_PASSWORD_REQUESTS_PER_IP=10
AUTH_PASSWORD_REQUESTS_PER_ACCOUNT=3
PASSWORD_RESET_TTL_MINUTES=15
FRONTEND_URL=http://localhost:8080
PUBLIC_BASE_URL=http://127.0.0.1:8080
PUBLIC_BASE_URL_ALLOW_HTTP=false

# Gmail SMTP. SMTP_PASSWORD must be a Google App Password, not the Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAME=localhost
OLLAMA_BASE_URL=http://ollama:11434
TRUSTED_LOCAL_PROVIDER_HOSTS=
AI_RERANK_ENABLED=true
LOCAL_AI_DOWNLOAD_ENABLED=true
OLLAMA_MODEL=gemma3:1b

# RAG chat smoke test (host-side script; never commit real keys)
# The runner falls back to GEMINI_API_KEY for both provider secrets.
RAGHUB_EXTERNAL_EMBEDDING_PROVIDER_TYPE=GOOGLE_GEMINI
RAGHUB_EXTERNAL_EMBEDDING_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
RAGHUB_EXTERNAL_EMBEDDING_MODEL=gemini-embedding-2
RAGHUB_EXTERNAL_EMBEDDING_DIMENSION=3072
RAGHUB_EXTERNAL_EMBEDDING_API_KEY=
RAGHUB_EXTERNAL_CHAT_PROVIDER_TYPE=GOOGLE_GEMINI
RAGHUB_EXTERNAL_CHAT_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
RAGHUB_EXTERNAL_CHAT_MODEL=gemini-3.5-flash-lite
RAGHUB_EXTERNAL_CHAT_API_KEY=
# Disabled for providers whose OpenAI-compatible stream does not return native usage.
RAGHUB_EXTERNAL_INCLUDE_STREAM_USAGE=false
RAGHUB_LOCAL_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
RAGHUB_LOCAL_EMBEDDING_DIMENSION=384
RAGHUB_OLLAMA_BASE_URL=http://ollama:11434
PUBLIC_CHAT_REQUESTS_PER_IP=20
PUBLIC_CHAT_REQUESTS_PER_CHATBOT=120
PUBLIC_CHAT_CONCURRENT_PER_CHATBOT=4
PUBLIC_CHAT_CONCURRENT_GLOBAL=32
PUBLIC_CHAT_STREAM_TIMEOUT_SECONDS=90
# Local Docker network range; production must restrict this to its actual proxy CIDR.
PUBLIC_CHAT_TRUSTED_PROXY_CIDRS=172.16.0.0/12

# RAG capacity: pick one profile (custom | lite_cpu | standard_cpu | gpu).
# Precedence: explicit value below > hardware preset > backend default.
# Leave the preset-owned keys empty unless you intentionally override the preset.
RAG_HARDWARE_PROFILE=custom
RAG_WORKER_CONCURRENCY=
RAG_RETRIEVAL_CANDIDATES=
RAG_RERANK_SOURCE_COUNT=
RAG_RERANK_TOP_N=
RAG_RERANKER_ENABLED=
RAG_ADAPTIVE_RERANK_ENABLED=
PROVIDER_POOL_MAX_ACTIVE_JOBS_PER_WORKSPACE=

# Optional RAG stages; enable individually after evaluation.
RAG_OCR_ENABLED=false
RAG_INDEX_GC_ENABLED=false
RAG_TELEMETRY_JSON_ENABLED=false
RAG_EMBEDDING_CACHE_ENABLED=false
RAG_NEIGHBOR_EXPANSION_ENABLED=false
RAG_ADAPTIVE_CLARIFICATION_ENABLED=false
RAG_EVIDENCE_SELECTION_ENABLED=false
RAG_CONFIDENCE_HIGH_THRESHOLD=0.85
RAG_RELEVANCE_GATE_ENABLED=false
RAG_RERANKER_SNAPSHOT_PATH=
RAG_RERANKER_EXPECTED_SHA256=
RAG_RERANKER_TIMEOUT_SECONDS=2
RAG_MAX_CONTEXT_TOKENS=6000
RAG_MAX_OUTPUT_TOKENS=1024
RAG_PROMPT_SAFETY_MARGIN=256
RAG_RRF_K=60
RAG_MAX_CHUNKS_PER_DOCUMENT=1
RAG_EMBEDDING_SPEED_PROFILE=balanced
RAG_EMBEDDING_MAX_INFLIGHT_HARD_CAP=4
RAG_EMBEDDING_MAX_BATCH_CHUNKS_HARD_CAP=64
RAG_EMBEDDING_MAX_BATCH_TOKENS_HARD_CAP=50000
RAG_EMBEDDING_MAX_INFLIGHT_REQUESTS=
RAG_EMBEDDING_BATCH_MAX_CHUNKS=
RAG_EMBEDDING_BATCH_TARGET_TOKENS=
PROVIDER_POOL_MAX_PENDING_JOBS_PER_WORKSPACE=5
