# Application
APP_ENV=development
APP_NAME=RagHub API
APP_SECRET_KEY=change-me-in-local-env
API_V1_PREFIX=/api/v1
MAX_UPLOAD_SIZE_MB=25

# PostgreSQL
POSTGRES_DB=raghub
POSTGRES_USER=raghub
POSTGRES_PASSWORD=raghub-local-only
DATABASE_URL=postgresql+asyncpg://raghub:raghub-local-only@postgres:5432/raghub

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Elasticsearch
ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_INDEX=raghub_chunks_v1
ELASTICSEARCH_ALIAS=raghub_chunks_current

# MinIO / S3-compatible storage
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=raghub
S3_SECRET_KEY=raghub-local-only
S3_BUCKET=raghub-documents
S3_SECURE=false

# Reserved for later phases
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
OLLAMA_BASE_URL=http://ollama:11434
