# Application
APP_ENV=development
APP_NAME=RagHub API
APP_SECRET_KEY=change-me-in-local-env
PROVIDER_MASTER_KEY=replace-with-a-dedicated-provider-encryption-key
# Use local-ai to install sentence-transformers/PyTorch in API and worker images.
BACKEND_IMAGE_TARGET=runtime
API_V1_PREFIX=/api/v1
MAX_UPLOAD_SIZE_MB=25

# PostgreSQL
POSTGRES_DB=raghub
POSTGRES_USER=raghub
POSTGRES_PASSWORD=raghub-local-only
DATABASE_URL=postgresql+asyncpg://raghub:raghub-local-only@postgres:5432/raghub

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Public chatbot security and quotas
PUBLIC_API_KEY_PEPPER=change-me-public-api-key-pepper
PUBLIC_CHAT_RATE_LIMIT_REQUESTS=30
PUBLIC_CHAT_RATE_LIMIT_WINDOW_SECONDS=60
PUBLIC_CONVERSATION_RATE_LIMIT_REQUESTS=10
PUBLIC_CONVERSATION_RATE_LIMIT_WINDOW_SECONDS=60
PUBLIC_CHAT_MAX_CONCURRENT_PER_CHATBOT=4
PUBLIC_CHAT_MAX_CONCURRENT_PER_ORG=10
PUBLIC_CHAT_CONCURRENCY_LEASE_SECONDS=180
TRUST_PROXY_HEADERS=true
TRUSTED_PROXY_CIDRS=172.30.0.10/32
RAGHUB_NETWORK_SUBNET=172.30.0.0/24
RAGHUB_PROXY_IP=172.30.0.10

# Elasticsearch
ELASTICSEARCH_URL=http://elasticsearch:9200

# MinIO / S3-compatible storage
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=raghub
S3_SECRET_KEY=raghub-local-only
S3_BUCKET=raghub-documents
S3_SECURE=false

# Legacy Gemini bootstrap settings (new credentials are stored through the provider API)
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL=gemini-3.5-flash-lite
CHAT_PROVIDER_TIMEOUT_SECONDS=45

# Reserved for later phases
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=gemma3:1b

# RAG chat smoke test (host-side script; never commit real keys)
# The runner falls back to GEMINI_API_KEY for both provider secrets.
RAGHUB_EXTERNAL_EMBEDDING_PROVIDER_TYPE=GOOGLE_GEMINI
RAGHUB_EXTERNAL_EMBEDDING_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
RAGHUB_EXTERNAL_EMBEDDING_MODEL=gemini-embedding-2
RAGHUB_EXTERNAL_EMBEDDING_DIMENSION=3072
RAGHUB_EXTERNAL_EMBEDDING_API_KEY=
RAGHUB_EXTERNAL_CHAT_PROVIDER_TYPE=GOOGLE_GEMINI
RAGHUB_EXTERNAL_CHAT_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
RAGHUB_EXTERNAL_CHAT_MODEL=gemini-3.5-flash-lite
RAGHUB_EXTERNAL_CHAT_API_KEY=
# Disabled for providers whose OpenAI-compatible stream does not return native usage.
RAGHUB_EXTERNAL_INCLUDE_STREAM_USAGE=false
RAGHUB_LOCAL_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
RAGHUB_LOCAL_EMBEDDING_DIMENSION=384
RAGHUB_OLLAMA_BASE_URL=http://ollama:11434
