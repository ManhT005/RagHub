# Copy to .env.self-host; values in that file are private.
# Runtime and published images (immutable release or sha tag)
APP_ENV=selfhost
COMPOSE_PROJECT_NAME=raghub-selfhost
RAGHUB_IMAGE_PREFIX=ghcr.io/manht005/raghub
RAGHUB_IMAGE_TAG=
BACKEND_IMAGE_SUFFIX=-local-ai
APP_SECRET_KEY=
PROVIDER_MASTER_KEY=
FRONTEND_URL=https://raghub.example.com
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
REFRESH_REUSE_GRACE_SECONDS=10
AUTH_LOGIN_REQUESTS_PER_IP=10
AUTH_LOGIN_REQUESTS_PER_ACCOUNT=5
AUTH_PASSWORD_REQUESTS_PER_IP=10
AUTH_PASSWORD_REQUESTS_PER_ACCOUNT=3
HTTP_BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080

# Database: use URL-safe random passwords or set DATABASE_URL with URL encoding.
POSTGRES_DB=raghub
POSTGRES_USER=raghub
POSTGRES_PASSWORD=

# Object storage and vector search: internal services, never published.
S3_ACCESS_KEY=raghub
S3_SECRET_KEY=
S3_BUCKET=raghub-documents
# ELASTICSEARCH_URL=http://elasticsearch:9200

# Redis queue/admission persists AOF in redis-data.
# REDIS_URL=redis://redis:6379/0
# CELERY_BROKER_URL=redis://redis:6379/0
# CELERY_RESULT_BACKEND=redis://redis:6379/1

# Local AI: enable with --profile local-ai. CPU is the default.
OLLAMA_MODEL=gemma3:1b
OLLAMA_BASE_URL=http://ollama:11434
# Optional exact gateway hostnames, e.g. host.docker.internal,9router.
TRUSTED_LOCAL_PROVIDER_HOSTS=
CHAT_PROVIDER_TIMEOUT_SECONDS=120
MAX_UPLOAD_SIZE_MB=25

# Public chat: trust only the ingress gateway address.
PROXY_NETWORK_SUBNET=172.28.0.0/24
PROXY_IP=172.28.0.10
PUBLIC_CHAT_TRUSTED_PROXY_CIDRS=172.28.0.10/32
PUBLIC_CHAT_REQUESTS_PER_IP=20
PUBLIC_CHAT_REQUESTS_PER_CHATBOT=120
PUBLIC_CHAT_CONCURRENT_PER_CHATBOT=4
PUBLIC_CHAT_CONCURRENT_GLOBAL=32
PUBLIC_CHAT_STREAM_TIMEOUT_SECONDS=300

# Optional email auth/recovery. Bootstrap and password login work without SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAME=raghub.example.com
