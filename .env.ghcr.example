# Copy to .env.ghcr and fill values before deploying. Never commit .env.ghcr.
APP_ENV=production
COMPOSE_PROJECT_NAME=raghub-production
APP_NAME=RagHub API
RAGHUB_IMAGE_PREFIX=ghcr.io/manht005/raghub
# Use a published release (e.g. 1.0.0) or immutable sha-<full-commit> tag.
RAGHUB_IMAGE_TAG=
# Empty = runtime; -local-ai = backend with Sentence Transformers/CPU PyTorch.
BACKEND_IMAGE_SUFFIX=

APP_SECRET_KEY=
PROVIDER_MASTER_KEY=
POSTGRES_DB=raghub
POSTGRES_USER=raghub
POSTGRES_PASSWORD=
# Optional DATABASE_URL override, needed when password contains URL-reserved characters.
# DATABASE_URL=postgresql+asyncpg://raghub:URL_ENCODED_PASSWORD@postgres:5432/raghub
S3_ACCESS_KEY=raghub
S3_SECRET_KEY=
S3_BUCKET=raghub-documents

# Gateway behind a host HTTPS reverse proxy. Set 0.0.0.0 for direct LAN access.
HTTP_BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080
FRONTEND_URL=https://raghub.example.com
PROXY_NETWORK_SUBNET=172.28.0.0/24
PROXY_IP=172.28.0.10
PUBLIC_CHAT_TRUSTED_PROXY_CIDRS=172.28.0.10/32

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

PUBLIC_CHAT_REQUESTS_PER_IP=20
PUBLIC_CHAT_REQUESTS_PER_CHATBOT=120
PUBLIC_CHAT_CONCURRENT_PER_CHATBOT=4
PUBLIC_CHAT_CONCURRENT_GLOBAL=32
PUBLIC_CHAT_STREAM_TIMEOUT_SECONDS=90
CHAT_PROVIDER_TIMEOUT_SECONDS=45
MAX_UPLOAD_SIZE_MB=25
OLLAMA_MODEL=gemma3:1b
