# Reference preset for lite_cpu (low memory / 1 CPU worker).
# NOTE: Docker Compose does NOT auto-load this file.
# To use this preset, set `RAG_HARDWARE_PROFILE=lite_cpu` in `.env.self-host`.
# Only specify individual variables below if you wish to override the preset defaults.
RAG_HARDWARE_PROFILE=lite_cpu
RAG_WORKER_CONCURRENCY=1
RAG_RETRIEVAL_CANDIDATES=15
RAG_RERANK_SOURCE_COUNT=12
RAG_RERANK_TOP_N=5
RAG_RERANKER_ENABLED=false
PROVIDER_POOL_MAX_ACTIVE_JOBS_PER_WORKSPACE=1
