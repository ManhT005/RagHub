# Reference preset for standard_cpu (standard CPU multi-core).
# NOTE: Docker Compose does NOT auto-load this file.
# To use this preset, set `RAG_HARDWARE_PROFILE=standard_cpu` in `.env.self-host`.
# Only specify individual variables below if you wish to override the preset defaults.
RAG_HARDWARE_PROFILE=standard_cpu
RAG_WORKER_CONCURRENCY=1
RAG_RETRIEVAL_CANDIDATES=25
RAG_RERANK_SOURCE_COUNT=20
RAG_RERANK_TOP_N=6
RAG_ADAPTIVE_RERANK_ENABLED=true
PROVIDER_POOL_MAX_ACTIVE_JOBS_PER_WORKSPACE=1
